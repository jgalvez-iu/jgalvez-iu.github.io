  <script>
    let faceapi, detections = [], video;
    let currentExpression = { dominant: 'neutral', intensity: 0 };
    let smoothIntensity = 0;

    const emotionsCA = {
      happy: "feliç",
      sad: "trist",
      angry: "enfadat",
      surprised: "sorprès",
      disgusted: "fastiguejat",
      fearful: "espantat",
      neutral: "neutral"
    };

    const emotionsEmoji = {
      happy: "😄",
      sad: "😢",
      angry: "😠",
      surprised: "😲",
      disgusted: "🤢",
      fearful: "😱",
      neutral: "😐"
    };

    function setup() {
      createCanvas(windowWidth, windowHeight);

      video = createCapture(VIDEO);
      video.size(320, 240);
      video.hide();
      video.elt.muted = true;
      video.elt.setAttribute('playsinline', '');

      const options = {
        withLandmarks: false,
        withExpressions: true,
        withDescriptors: false
      };

      faceapi = ml5.faceApi(video, options, () => {
        document.getElementById('loading-screen').style.display = 'none';
        faceapi.detect(gotResults);
      });
    }

    function windowResized() {
      resizeCanvas(windowWidth, windowHeight);
    }

    function gotResults(err, results) {
      if (err) {
        console.error(err);
        document.getElementById('loading-screen').innerHTML =
          '<p style="color:red">Error! Comprova la càmera i actualitza la pàgina.</p>';
        return;
      }

      detections = results || [];

      if (detections.length > 0) {
        updateCurrentExpression();
      } else {
        currentExpression = { dominant: 'neutral', intensity: 0 };
      }

      faceapi.detect(gotResults);
    }

    function updateCurrentExpression() {
      let maxIntensity = 0;

      detections.forEach(face => {
        const expr = face.expressions;
        const dominant = Object.keys(expr).reduce((a, b) => expr[a] > expr[b] ? a : b);

        if (expr[dominant] > maxIntensity) {
          currentExpression = {
            dominant,
            intensity: expr[dominant]
          };
          maxIntensity = expr[dominant];
        }
      });
    }

    function getBackgroundColor(dominant, intensity) {
      switch (dominant) {
        case 'happy':
          return { r: 255, g: 240, b: map(intensity, 1, 0, 120, 220) };

        case 'sad':
          return {
            r: map(intensity, 1, 0, 130, 210),
            g: map(intensity, 1, 0, 170, 220),
            b: 255
          };

        case 'angry':
          return {
            r: 255,
            g: map(intensity, 1, 0, 80, 210),
            b: map(intensity, 1, 0, 70, 210)
          };

        case 'disgusted':
          return {
            r: map(intensity, 1, 0, 140, 220),
            g: 220,
            b: map(intensity, 1, 0, 90, 220)
          };

        case 'surprised':
          return { r: 255, g: 205, b: 125 };

        case 'fearful':
          return { r: 170, g: 160, b: 250 };

        default:
          return { r: 215, g: 215, b: 215 };
      }
    }

    function draw() {
      smoothIntensity = lerp(smoothIntensity, currentExpression.intensity, 0.1);

      const bg = getBackgroundColor(currentExpression.dominant, smoothIntensity);
      background(bg.r, bg.g, bg.b);

      drawTomMood(currentExpression.dominant, smoothIntensity);

      // Vídeo petit
      let vW = min(180, width * 0.22);
      let vH = vW * 0.75;
      let margin = 20;

      push();
      translate(width - vW - margin, height - vH - margin);
      stroke(255);
      strokeWeight(2);
      fill(0, 170);
      rect(-6, -6, vW + 12, vH + 12, 12);
      image(video, 0, 0, vW, vH);
      pop();

      // Text superior
      fill(30, 190);
      noStroke();
      textAlign(CENTER, TOP);
      textSize(min(28, width * 0.045));

      let label = emotionsCA[currentExpression.dominant] || "neutral";
      let emoji = emotionsEmoji[currentExpression.dominant] || "😐";

      text(
        `${emoji} Sentiment detectat: ${label} (${(smoothIntensity * 100).toFixed(0)}%)`,
        width / 2,
        20
      );
    }

