    function drawTomMood(mood, intensity) {
      push();

      translate(width / 2, height / 2);
      let escala = min(width / 320, height / 480) * 0.9;
      scale(escala);

      // centre una mica més baix perquè quedi millor visualment
      translate(-160, -232);

      // animacions globals estil cartoon
      if (mood === 'happy') {
        let bounce = sin(frameCount * 0.18) * map(intensity, 0, 1, 0, 8);
        translate(0, bounce);
      }

      if (mood === 'fearful') {
        let shakeX = sin(frameCount * 1.0) * map(intensity, 0, 1, 0, 5);
        let shakeY = sin(frameCount * 0.7) * map(intensity, 0, 1, 0, 2);
        translate(shakeX, shakeY);
      }

      if (mood === 'angry') {
        let pulse = 1 + sin(frameCount * 0.18) * map(intensity, 0, 1, 0, 0.015);
        scale(pulse);
      }

      if (mood === 'surprised') {
        let jump = abs(sin(frameCount * 0.22)) * map(intensity, 0, 1, 0, 8);
        translate(0, -jump);
      }

      drawTomBase();

      // netegem zones variables
      netejaBocaTom();
      netejaCellesTom();

      // repassem nas
      redibuixaNasTom();

      // parpelles més expressives
      dibuixaParpellesTom(mood, intensity);

      switch (mood) {
        case 'happy':
          bocaFelic(intensity);
          cellesFelic(intensity);
          galtesFelic(intensity);
          break;

        case 'sad':
          bocaTrista(intensity);
          cellesTristes(intensity);
          llagrima(intensity);
          break;

        case 'angry':
          bocaEnfadada(intensity);
          cellesEnfadades(intensity);
          veinsEnfad(intensity);
          break;

        case 'surprised':
          bocaSorpresa(intensity);
          cellesSorpresa(intensity);
          break;

        case 'disgusted':
          bocaDisgust(intensity);
          cellesDisgust(intensity);
          break;

        case 'fearful':
          bocaPor(intensity);
          cellesPor(intensity);
          suorPor(intensity);
          break;

        default:
          bocaNeutral(intensity);
          cellesNeutral(intensity);
          break;
      }

      pop();
    }

