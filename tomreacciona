    // ======================================================
    // PARPELLES / ULLS MÉS EXPRESSIUS
    // ======================================================

    function dibuixaParpellesTom(mood, intensity) {
      noStroke();
      fill(197, 204, 201);

      // happy -> ulls una mica més somrients
      if (mood === 'happy') {
        let d = map(intensity, 0, 1, 0, 4);

        beginShape();
        vertex(120, 90);
        bezierVertex(124, 84 - d, 129, 79 - d, 135, 77);
        bezierVertex(136, 81, 135, 85, 132, 88);
        bezierVertex(128, 92, 124, 93, 120, 90);
        endShape(CLOSE);

        beginShape();
        vertex(145, 100);
        bezierVertex(148, 93 - d, 152, 88 - d, 156, 85);
        bezierVertex(158, 88, 158, 93, 155, 98);
        bezierVertex(152, 101, 149, 102, 145, 100);
        endShape(CLOSE);
      }

      // sad -> parpella més caiguda
      if (mood === 'sad') {
        let d = map(intensity, 0, 1, 0, 5);

        beginShape();
        vertex(120, 89);
        bezierVertex(124, 85, 129, 82, 134, 80);
        bezierVertex(134, 84 + d, 132, 88 + d, 127, 91 + d);
        bezierVertex(123, 92 + d, 121, 91 + d, 120, 89);
        endShape(CLOSE);

        beginShape();
        vertex(145, 100);
        bezierVertex(149, 94, 153, 89, 157, 86);
        bezierVertex(158, 90 + d, 156, 95 + d, 152, 99 + d);
        bezierVertex(149, 101 + d, 146, 101 + d, 145, 100);
        endShape(CLOSE);
      }

      // angry -> ulls més estrets
      if (mood === 'angry') {
        let d = map(intensity, 0, 1, 0, 6);

        beginShape();
        vertex(119, 88);
        bezierVertex(124, 82 - d, 130, 77 - d, 136, 76);
        bezierVertex(135, 82, 132, 88, 127, 91);
        bezierVertex(123, 92, 120, 91, 119, 88);
        endShape(CLOSE);

        beginShape();
        vertex(145, 99);
        bezierVertex(149, 91 - d, 154, 85 - d, 159, 83);
        bezierVertex(159, 89, 157, 95, 153, 99);
        bezierVertex(149, 101, 147, 101, 145, 99);
        endShape(CLOSE);
      }

      // disgusted -> un ull més tancat
      if (mood === 'disgusted') {
        beginShape();
        vertex(120, 89);
        bezierVertex(123, 84, 128, 81, 134, 79);
        bezierVertex(134, 83, 133, 87, 129, 90);
        bezierVertex(125, 91, 122, 91, 120, 89);
        endShape(CLOSE);

        beginShape();
        vertex(146, 101);
        bezierVertex(149, 96, 152, 93, 156, 92);
        bezierVertex(156, 95, 154, 98, 151, 100);
        bezierVertex(149, 101, 147, 101, 146, 101);
        endShape(CLOSE);
      }
    }

