<body>
  <div id="loading-screen">
    <div class="loader"></div>
    <p>Carregant models...</p>
  </div>

  <script>
    let faceapi, detections = [], video;
    let currentExpression = { dominant: 'neutral', intensity: 0 };
    let smoothIntensity = 0;

    const emotionsCA = {
      happy: "feliç",
      sad: "trist",
      angry: "enfadat",
      surprised: "sorprès",
      disgusted: "fastiguejat",
      fearful: "espantat",
      neutral: "neutral"
    };

    const emotionsEmoji = {
      happy: "😄",
      sad: "😢",
      angry: "😠",
      surprised: "😲",
      disgusted: "🤢",
      fearful: "😱",
      neutral: "😐"
    };

    function setup() {
      createCanvas(windowWidth, windowHeight);

      video = createCapture(VIDEO);
      video.size(320, 240);
      video.hide();
      video.elt.muted = true;
      video.elt.setAttribute('playsinline', '');

      const options = {
        withLandmarks: false,
        withExpressions: true,
        withDescriptors: false
      };

      faceapi = ml5.faceApi(video, options, () => {
        document.getElementById('loading-screen').style.display = 'none';
        faceapi.detect(gotResults);
      });
    }

    function windowResized() {
      resizeCanvas(windowWidth, windowHeight);
    }

    function gotResults(err, results) {
      if (err) {
        console.error(err);
        document.getElementById('loading-screen').innerHTML =
          '<p style="color:red">Error! Comprova la càmera i actualitza la pàgina.</p>';
        return;
      }

      detections = results || [];

      if (detections.length > 0) {
        updateCurrentExpression();
      } else {
        currentExpression = { dominant: 'neutral', intensity: 0 };
      }

      faceapi.detect(gotResults);
    }

    function updateCurrentExpression() {
      let maxIntensity = 0;

      detections.forEach(face => {
        const expr = face.expressions;
        const dominant = Object.keys(expr).reduce((a, b) => expr[a] > expr[b] ? a : b);

        if (expr[dominant] > maxIntensity) {
          currentExpression = {
            dominant,
            intensity: expr[dominant]
          };
          maxIntensity = expr[dominant];
        }
      });
    }

    function getBackgroundColor(dominant, intensity) {
      switch (dominant) {
        case 'happy':
          return { r: 255, g: 240, b: map(intensity, 1, 0, 120, 220) };

        case 'sad':
          return {
            r: map(intensity, 1, 0, 130, 210),
            g: map(intensity, 1, 0, 170, 220),
            b: 255
          };

        case 'angry':
          return {
            r: 255,
            g: map(intensity, 1, 0, 80, 210),
            b: map(intensity, 1, 0, 70, 210)
          };

        case 'disgusted':
          return {
            r: map(intensity, 1, 0, 140, 220),
            g: 220,
            b: map(intensity, 1, 0, 90, 220)
          };

        case 'surprised':
          return { r: 255, g: 205, b: 125 };

        case 'fearful':
          return { r: 170, g: 160, b: 250 };

        default:
          return { r: 215, g: 215, b: 215 };
      }
    }

    function draw() {
      smoothIntensity = lerp(smoothIntensity, currentExpression.intensity, 0.1);

      const bg = getBackgroundColor(currentExpression.dominant, smoothIntensity);
      background(bg.r, bg.g, bg.b);

      drawTomMood(currentExpression.dominant, smoothIntensity);

      // Vídeo petit
      let vW = min(180, width * 0.22);
      let vH = vW * 0.75;
      let margin = 20;

      push();
      translate(width - vW - margin, height - vH - margin);
      stroke(255);
      strokeWeight(2);
      fill(0, 170);
      rect(-6, -6, vW + 12, vH + 12, 12);
      image(video, 0, 0, vW, vH);
      pop();

      // Text superior
      fill(30, 190);
      noStroke();
      textAlign(CENTER, TOP);
      textSize(min(28, width * 0.045));

      let label = emotionsCA[currentExpression.dominant] || "neutral";
      let emoji = emotionsEmoji[currentExpression.dominant] || "😐";

      text(
        `${emoji} Sentiment detectat: ${label} (${(smoothIntensity * 100).toFixed(0)}%)`,
        width / 2,
        20
      );
    }

    // ======================================================
    // DIBUIX PRINCIPAL DE TOM (VERSIÓ B)
    // ======================================================

    function drawTomMood(mood, intensity) {
      push();

      translate(width / 2, height / 2);
      let escala = min(width / 320, height / 480) * 0.9;
      scale(escala);

      // centre una mica més baix perquè quedi millor visualment
      translate(-160, -232);

      // animacions globals estil cartoon
      if (mood === 'happy') {
        let bounce = sin(frameCount * 0.18) * map(intensity, 0, 1, 0, 8);
        translate(0, bounce);
      }

      if (mood === 'fearful') {
        let shakeX = sin(frameCount * 1.0) * map(intensity, 0, 1, 0, 5);
        let shakeY = sin(frameCount * 0.7) * map(intensity, 0, 1, 0, 2);
        translate(shakeX, shakeY);
      }

      if (mood === 'angry') {
        let pulse = 1 + sin(frameCount * 0.18) * map(intensity, 0, 1, 0, 0.015);
        scale(pulse);
      }

      if (mood === 'surprised') {
        let jump = abs(sin(frameCount * 0.22)) * map(intensity, 0, 1, 0, 8);
        translate(0, -jump);
      }

      drawTomBase();

      // netegem zones variables
      netejaBocaTom();
      netejaCellesTom();

      // repassem nas
      redibuixaNasTom();

      // parpelles més expressives
      dibuixaParpellesTom(mood, intensity);

      switch (mood) {
        case 'happy':
          bocaFelic(intensity);
          cellesFelic(intensity);
          galtesFelic(intensity);
          break;

        case 'sad':
          bocaTrista(intensity);
          cellesTristes(intensity);
          llagrima(intensity);
          break;

        case 'angry':
          bocaEnfadada(intensity);
          cellesEnfadades(intensity);
          veinsEnfad(intensity);
          break;

        case 'surprised':
          bocaSorpresa(intensity);
          cellesSorpresa(intensity);
          break;

        case 'disgusted':
          bocaDisgust(intensity);
          cellesDisgust(intensity);
          break;

        case 'fearful':
          bocaPor(intensity);
          cellesPor(intensity);
          suorPor(intensity);
          break;

        default:
          bocaNeutral(intensity);
          cellesNeutral(intensity);
          break;
      }

      pop();
    }

    // ======================================================
    // BASE ORIGINAL DE TOM (EL TEU DIBUIX)
    // ======================================================

    function drawTomBase() {
