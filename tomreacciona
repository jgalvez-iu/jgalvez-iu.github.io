      curveVertex(69.5, 40.609375);
      curveVertex(69.5, 45.609375);
      curveVertex(65.5, 50.609375);
      curveVertex(61.5, 52.609375);
      curveVertex(55.5, 57.609375);
      curveVertex(52.5, 64.609375);
      curveVertex(52.5, 72.609375);
      curveVertex(49.5, 77.609375);
      curveVertex(47.5, 83.609375);
      curveVertex(50.5, 95.609375);
      curveVertex(57.5, 108.609375);
      curveVertex(64.5, 120.609375);
      curveVertex(69.5, 128.609375);
      curveVertex(71.5, 130.609375);
