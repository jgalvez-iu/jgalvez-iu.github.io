    // ======================================================
    // NETEJA DE ZONES VARIABLES
    // ======================================================

    function netejaBocaTom() {
      noStroke();
      fill(255);

      beginShape();
      vertex(112, 112);
      bezierVertex(120, 118, 128, 122, 139, 123);
      bezierVertex(149, 123, 157, 120, 161, 123);
      bezierVertex(163, 129, 160, 138, 154, 144);
      bezierVertex(149, 147, 143, 150, 135, 149);
      bezierVertex(126, 148, 118, 144, 112, 136);
      bezierVertex(109, 129, 108, 120, 112, 112);
      endShape(CLOSE);
    }

    function netejaCellesTom() {
      noStroke();
      fill(197, 204, 201);

      ellipse(140, 49, 18, 10);
      ellipse(170, 53, 18, 14);
    }

    function redibuixaNasTom() {
      fill(0,0,0);
      stroke(0);
      strokeWeight(1.5);

      beginShape();
      curveVertex(117.5, 106.609375);
      curveVertex(120.5, 104.609375);
      curveVertex(127.5, 103.609375);
      curveVertex(129.5, 100.609375);
      curveVertex(128.5, 98.609375);
      curveVertex(126.5, 95.609375);
      curveVertex(121.5, 94.609375);
      curveVertex(117.5, 93.609375);
      curveVertex(114.5, 94.609375);
      curveVertex(113.5, 98.609375);
      curveVertex(114.5, 101.609375);
      curveVertex(115.5, 104.609375);
      endShape(CLOSE);
    }

    // ======================================================
    // PARPELLES / ULLS MÉS EXPRESSIUS
    // ======================================================

    function dibuixaParpellesTom(mood, intensity) {
      noStroke();
      fill(197, 204, 201);

      // happy -> ulls una mica més somrients
      if (mood === 'happy') {
        let d = map(intensity, 0, 1, 0, 4);

        beginShape();
        vertex(120, 90);
        bezierVertex(124, 84 - d, 129, 79 - d, 135, 77);
        bezierVertex(136, 81, 135, 85, 132, 88);
        bezierVertex(128, 92, 124, 93, 120, 90);
        endShape(CLOSE);

        beginShape();
        vertex(145, 100);
        bezierVertex(148, 93 - d, 152, 88 - d, 156, 85);
        bezierVertex(158, 88, 158, 93, 155, 98);
        bezierVertex(152, 101, 149, 102, 145, 100);
        endShape(CLOSE);
      }

      // sad -> parpella més caiguda
      if (mood === 'sad') {
        let d = map(intensity, 0, 1, 0, 5);

        beginShape();
        vertex(120, 89);
        bezierVertex(124, 85, 129, 82, 134, 80);
        bezierVertex(134, 84 + d, 132, 88 + d, 127, 91 + d);
        bezierVertex(123, 92 + d, 121, 91 + d, 120, 89);
        endShape(CLOSE);

        beginShape();
        vertex(145, 100);
        bezierVertex(149, 94, 153, 89, 157, 86);
        bezierVertex(158, 90 + d, 156, 95 + d, 152, 99 + d);
        bezierVertex(149, 101 + d, 146, 101 + d, 145, 100);
        endShape(CLOSE);
      }

      // angry -> ulls més estrets
      if (mood === 'angry') {
        let d = map(intensity, 0, 1, 0, 6);

        beginShape();
        vertex(119, 88);
        bezierVertex(124, 82 - d, 130, 77 - d, 136, 76);
        bezierVertex(135, 82, 132, 88, 127, 91);
        bezierVertex(123, 92, 120, 91, 119, 88);
        endShape(CLOSE);

        beginShape();
        vertex(145, 99);
        bezierVertex(149, 91 - d, 154, 85 - d, 159, 83);
        bezierVertex(159, 89, 157, 95, 153, 99);
        bezierVertex(149, 101, 147, 101, 145, 99);
        endShape(CLOSE);
      }

      // disgusted -> un ull més tancat
      if (mood === 'disgusted') {
        beginShape();
        vertex(120, 89);
        bezierVertex(123, 84, 128, 81, 134, 79);
        bezierVertex(134, 83, 133, 87, 129, 90);
        bezierVertex(125, 91, 122, 91, 120, 89);
        endShape(CLOSE);

        beginShape();
        vertex(146, 101);
        bezierVertex(149, 96, 152, 93, 156, 92);
        bezierVertex(156, 95, 154, 98, 151, 100);
        bezierVertex(149, 101, 147, 101, 146, 101);
        endShape(CLOSE);
      }
    }

    // ======================================================
    // BOQUES DE TOM (VERSIÓ B)
    // ======================================================

    function bocaNeutral(intensity) {
      noFill();
      stroke(20);
      strokeWeight(3);
      beginShape();
      vertex(123, 127);
      bezierVertex(128, 125, 133, 124, 138, 124);
      bezierVertex(143, 124, 147, 125, 151, 127);
      endShape();
    }

    function bocaFelic(intensity) {
      noFill();
      stroke(20);
      strokeWeight(4);

      let smileW = map(intensity, 0, 1, 28, 42);
      let smileH = map(intensity, 0, 1, 8, 18);

      arc(137, 124, smileW, smileH * 2, 0, PI);

      noStroke();
      fill(160, 40, 60, 140);
      arc(137, 129, map(intensity, 0, 1, 10, 20), map(intensity, 0, 1, 4, 10), 0, PI);

      stroke(20);
      strokeWeight(2.5);
      line(122, 127, 120, 124);
      line(152, 127, 154, 124);
    }

    function bocaTrista(intensity) {
      noFill();
      stroke(20);
      strokeWeight(4);

      let w = map(intensity, 0, 1, 20, 32);
      let h = map(intensity, 0, 1, 6, 14);

      arc(137, 136, w, h * 2, PI, TWO_PI);
    }

    function bocaEnfadada(intensity) {
      noFill();
      stroke(20);
      strokeWeight(4);

      beginShape();
      vertex(122, 128);
      vertex(128, 124);
      vertex(136, 130);
      vertex(144, 124);
      vertex(152, 128);
      endShape();

      strokeWeight(2);
      line(121, 128, 118, 126);
      line(152, 128, 155, 126);
    }

    function bocaSorpresa(intensity) {
      fill(30);
      stroke(20);
      strokeWeight(2.5);

      let w = map(intensity, 0, 1, 10, 18);
      let h = map(intensity, 0, 1, 14, 26);
      ellipse(137, 128, w, h);
    }

    function bocaDisgust(intensity) {
      noFill();
      stroke(20);
      strokeWeight(4);

      let wobble = sin(frameCount * 0.15) * map(intensity, 0, 1, 0.5, 2.5);

      beginShape();
      vertex(122, 128);
      vertex(129, 124 + wobble);
      vertex(137, 130 - wobble);
      vertex(145, 125 + wobble);
      vertex(152, 123);
      endShape();
    }

    function bocaPor(intensity) {
      push();
      let tremble = sin(frameCount * 1.1) * map(intensity, 0, 1, 0, 1.5);
      translate(tremble, 0);

      fill(25);
      stroke(20);
      strokeWeight(2.5);

      let w = map(intensity, 0, 1, 10, 16);
      let h = map(intensity, 0, 1, 15, 22);
      ellipse(137, 129, w, h);

      pop();
    }

    // ======================================================
    // CELLES DE TOM (VERSIÓ B)
    // ======================================================

    function cellesNeutral(intensity) {
      stroke(0);
      strokeWeight(3);
      line(136, 49, 144, 49);
      line(165, 49, 174, 50);
    }

    function cellesFelic(intensity) {
      stroke(0);
      strokeWeight(3);

      let lift = map(intensity, 0, 1, 0, 4);
      line(136, 50 - lift, 145, 49);
      line(165, 50 - lift, 174, 52);
    }

    function cellesTristes(intensity) {
      stroke(0);
      strokeWeight(3);

      let d = map(intensity, 0, 1, 0, 6);
      line(136, 48, 145, 54 + d);
      line(164, 54 + d, 176, 48);
    }

    function cellesEnfadades(intensity) {
      stroke(0);
      strokeWeight(3.5);

      let d = map(intensity, 0, 1, 0, 8);
      line(135, 54, 145, 46 - d);
      line(164, 46 - d, 176, 55);
    }

    function cellesSorpresa(intensity) {
      stroke(0);
      strokeWeight(2.5);
      noFill();

      let lift = map(intensity, 0, 1, 5, 12);
      arc(140, 48 - lift, 14, 6, PI, TWO_PI);
      arc(170, 48 - lift, 16, 6, PI, TWO_PI);
    }

    function cellesDisgust(intensity) {
      stroke(0);
      strokeWeight(3);
      line(136, 50, 145, 47);
      line(165, 47, 176, 52);
    }

    function cellesPor(intensity) {
      stroke(0);
      strokeWeight(2.5);
      noFill();

      let lift = map(intensity, 0, 1, 6, 12);
      arc(140, 48 - lift, 15, 7, PI, TWO_PI);
      arc(170, 48 - lift, 17, 7, PI, TWO_PI);
    }

    // ======================================================
    // EFECTES EXTRA
    // ======================================================

    function galtesFelic(intensity) {
      noStroke();
      fill(255, 160, 170, map(intensity, 0, 1, 25, 90));
      ellipse(115, 126, 10, 6);
      ellipse(156, 127, 10, 6);
    }

    function llagrima(intensity) {
      let h = sin(frameCount * 0.08) * map(intensity, 0, 1, 1, 3);

      fill(120, 180, 255, 220);
      stroke(80, 130, 220);
      strokeWeight(1.5);

      beginShape();
      vertex(158, 104 + h);
      bezierVertex(162, 111 + h, 161, 118 + h, 156, 121 + h);
      bezierVertex(151, 117 + h, 152, 110 + h, 158, 104 + h);
      endShape(CLOSE);
    }

    function suorPor(intensity) {
      let h = sin(frameCount * 0.08) * map(intensity, 0, 1, 1, 4);

      fill(140, 200, 255, 220);
      stroke(80, 140, 220);
      strokeWeight(1.5);

      beginShape();
      vertex(181, 56 + h);
      bezierVertex(186, 63 + h, 184, 71 + h, 179, 75 + h);
      bezierVertex(173, 70 + h, 174, 62 + h, 181, 56 + h);
      endShape(CLOSE);
    }

    function veinsEnfad(intensity) {
      stroke(180, 0, 0, map(intensity, 0, 1, 80, 220));
      strokeWeight(2.2);

      let s = map(intensity, 0, 1, 0, 4);

      line(185, 40, 191 + s, 34);
      line(191 + s, 34, 196 + s, 39);
      line(191 + s, 34, 190 + s, 28);
      line(191 + s, 34, 198 + s, 33);
    }
